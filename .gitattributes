# Normalize line endings in the repository itself so that the same sources
# produce the same bytes on Windows, macOS and Linux. Without this, a global
# core.autocrlf=true rewrites LF to CRLF on checkout and every diff shows
# whitespace-only noise.
* text=auto eol=lf

# Scripts and sources are plain text and must stay LF so the deterministic
# packer produces identical archives everywhere.
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.json  text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.ps1  text eol=crlf
*.svg  text eol=lf

# Binary assets must never be touched.
*.tgz   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.zip   binary
*.woff  binary
*.woff2 binary
